# ================================================================
# Tiny Universe — Environment Variables
# ================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production (Vercel):
#   Set these variables in the Vercel dashboard:
#   Project Settings → Environment Variables
#   Do NOT commit any file with real values.
# ================================================================

# ─── MongoDB Atlas ────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com
# Navigate to: Your Cluster → Connect → Drivers → Node.js
MONGODB_URI=

# ─── Universe Passcode ────────────────────────────────────────
# The secret passcode users enter on the landing page to unlock
# their universe. Choose something memorable but secret.
UNIVERSE_PASSCODE=


# ─── Deployment URL (Optional) ──────────────────────────────
# Used as the base URL for generating guest sharing links.
# If not set, it defaults to the current browser origin.
NEXT_PUBLIC_APP_URL=
